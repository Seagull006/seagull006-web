{
  "version": 8,
  "name": "Wild BC — ecological atlas (Maputnik editable)",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "relief": {
      "type": "raster",
      "tiles": [
        "https://tiles.openfreemap.org/natural_earth/ne2sr/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "maxzoom": 6,
      "attribution": "Natural Earth relief via OpenFreeMap"
    },
    "bec": {
      "type": "geojson",
      "data": "bc_bec_zones.geojson",
      "attribution": "Province of British Columbia — BEC Zones, generalized (1:2M)"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "land-background",
      "type": "background",
      "paint": {
        "background-color": "#f0eee8"
      }
    },
    {
      "id": "land-relief",
      "type": "raster",
      "source": "relief",
      "maxzoom": 7,
      "paint": {
        "raster-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          0.32,
          6,
          0.2
        ]
      }
    },
    {
      "id": "forest-context",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 8,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "wood"
      ],
      "paint": {
        "fill-color": "#bfd1b9",
        "fill-opacity": 0.52
      }
    },
    {
      "id": "bec-zones",
      "type": "fill",
      "source": "bec",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "ZONE"
          ],
          "BAFA",
          "#c8d3d9",
          "BG",
          "#e1c180",
          "BWBS",
          "#93b2a0",
          "CDF",
          "#78ac87",
          "CMA",
          "#bdcfd8",
          "CWH",
          "#4c947b",
          "ESSF",
          "#91aaa3",
          "ICH",
          "#63a389",
          "IDF",
          "#b4bd86",
          "IMA",
          "#aebcbf",
          "MH",
          "#80a9af",
          "MS",
          "#9fb1a0",
          "PP",
          "#d7a86d",
          "SBPS",
          "#b1b798",
          "SBS",
          "#91af94",
          "SWB",
          "#a8bfc0",
          "#d7d6c9"
        ],
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          0.74,
          6,
          0.72,
          9,
          0.55
        ]
      }
    },
    {
      "id": "bec-boundaries",
      "type": "line",
      "source": "bec",
      "paint": {
        "line-color": "#56675b",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          0.22,
          7,
          0.75,
          10,
          1.2
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          0.45,
          9,
          0.65
        ]
      }
    },
    {
      "id": "water-context",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "!=",
        [
          "get",
          "brunnel"
        ],
        "tunnel"
      ],
      "paint": {
        "fill-color": "#bbd4d9"
      }
    },
    {
      "id": "river-context",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 7,
      "paint": {
        "line-color": "#7faeb9",
        "line-opacity": 0.7,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          0.5,
          11,
          1.5
        ]
      }
    },
    {
      "id": "major-roads-context",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary"
          ]
        ]
      ],
      "paint": {
        "line-color": "#bfb4a1",
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.1,
          10,
          0.52
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.35,
          12,
          1.7
        ]
      }
    },
    {
      "id": "political-boundaries-context",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "==",
        [
          "get",
          "admin_level"
        ],
        2
      ],
      "paint": {
        "line-color": "#7d837e",
        "line-opacity": 0.55,
        "line-dasharray": [
          3,
          1.5
        ],
        "line-width": 0.8
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 7,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#527987",
        "text-halo-color": "#f0eee8",
        "text-halo-width": 1
      }
    },
    {
      "id": "cities-context",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "city",
            "town"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          10,
          8,
          13
        ],
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#44524b",
        "text-halo-color": "#f0eee8",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "village-context",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 9,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "village"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#64726b",
        "text-halo-color": "#f0eee8",
        "text-halo-width": 1
      }
    }
  ]
}
